{
  "kind": "singleType",
  "collectionName": "general_datas",
  "info": {
    "singularName": "general-data",
    "pluralName": "general-datas",
    "displayName": "Algemeen",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "address": {
      "type": "richtext"
    },
    "groupNumber": {
      "type": "string"
    },
    "vatNumber": {
      "type": "string"
    },
    "bankAccountNumber": {
      "type": "string"
    },
    "contactItems": {
      "type": "component",
      "component": "general.contact-item",
      "repeatable": true
    },
    "yearTheme": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::year-theme.year-theme"
    },
    "siteDescription": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "socials": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::social-item.social-item"
    },
    "leaderPrice": {
      "type": "decimal"
    },
    "memberPrice": {
      "type": "decimal"
    },
    "globalAlert": {
      "type": "component",
      "component": "general.global-alert",
      "repeatable": false
    },
    "maintenanceMode": {
      "type": "boolean",
      "default": false
    }
  }
}
